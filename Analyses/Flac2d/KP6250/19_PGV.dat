struct prop 5001 density 2500.0
;
set mech on
set dyn=on
;set flow on
;set mu on
;set fast off
set dytime=0.0
set step 200000000
set large
set ncwrite 100                    ; set saving step
set overwrite on
;
;set dy_damping local 0.02
set dy_damp rayl 0.02 8.0       ; define 5% damping for ground elements
; A1b
ini dy_damp hyst sig3 1.1 -0.66 -1.55  ; define hysteris of ground elements G D
;
; A1a
ini dy_damp hyst sig3 1.1 -0.67 -1.34 i 344 369 j 1 8
ini dy_damp hyst sig3 1.1 -0.67 -1.34 i 303 320 j 1 8
ini dy_damp hyst sig3 1.1 -0.67 -1.34 i 286 301 j 5 12
ini dy_damp hyst sig3 1.1 -0.67 -1.34 i 327 342 j 1 8
ini dy_damp hyst sig3 1.1 -0.67 -1.34 i 322 325 j 1 8
;
; A1c
ini dy_damp hyst sig3 1.1 -0.69 -1.2 i 41 82 j 1 18
ini dy_damp hyst sig3 1.1 -0.69 -1.2 i 120 123 j 1 10
ini dy_damp hyst sig3 1.1 -0.69 -1.2 i 37 40 j 1 8
ini dy_damp hyst sig3 1.1 -0.69 -1.2 i 103 118 j 1 10
ini dy_damp hyst sig3 1.1 -0.69 -1.2 i 20 35 j 1 8
ini dy_damp hyst sig3 1.1 -0.69 -1.2 i 84 101 j 1 10
ini dy_damp hyst sig3 1.1 -0.69 -1.2 i 1 18 j 1 8

;
;
;Read Velocity Time History
his read 100 ../Time-Histories/Vel_c/19_PGV.his
hist write 100 table 100
;
;
; apply dynamic boundaries at side boundaries and bottom boundary
ini xvel=0.0 yvel=0.0 xdisp=0.0 ydisp=0.0
;
; Velocity Time History
apply ff
attach aside from 1,1 to 1,9 bside from 83,1 to 83,9
attach aside from 84,11 to 84,1 bside from 83,19 to 83,9
attach aside from 268,1 to 268,5 bside from 251,18 to 251,22
attach aside from 125,1 to 125,18 bside from 251,1 to 251,18
attach aside from 303,1 to 303,9 bside from 370,1 to 370,9
apply xvel=0.01 hist table 100 from 1,1 to 19,1
apply xvel=0.01 hist table 100 from 20,1 to 36,1
apply xvel=0.01 hist table 100 from 37,1 to 83,1
;
apply yvel=0.0 from 1,1 to 19,1
apply yvel=0.0 from 20,1 to 36,1
apply yvel=0.0 from 37,1 to 83,1
;
;
;
hist reset
history nstep 150
history 2 dytime
;
;
; bl tr moment
history 201 element 29 moment1
history 202 element 62 moment1
; br tl moment
history 211 element 45 moment1
history 212 element 12 moment1
;
history 101 xdisp i=168, j=14
history 102 ydisp i=175, j=7
history 103 xdisp i=198, j=31
history 104 ydisp i=198, j=31
;
history 10 xdisp i=191, j=7
history 106 ydisp i=198, j=14
history 107 xdisp i=168, j=31
history 108 ydisp i=168, j=31
;
;
;
; Base
history 10 xvel i=75, j=1
; Tunnel
history 50 xvel i=183, j=38
; Above Tunnel
history 51 xvel i=337, j=8
; Ground Surface
history 55 xvel i=361, j=9
history 60 xaccel i=361, j=9
;
;
;
;
set dydt = 0.00001
solve dytime = 20.9
;
;
set hisfile=19_PGV/100.txt
hist write 100 vs 2
;
set hisfile=19_PGV/0010_Xvel_base.txt
hist write 10 vs 2
set hisfile=19_PGV/0050_Xvel_375_15.txt
hist write 50 vs 2
set hisfile=19_PGV/0051_Xvel_501_5.txt
hist write 51 vs 2
set hisfile=19_PGV/PGV.txt
hist write 55 vs 2
set hisfile=19_PGV/PGA.txt
hist write 60 vs 2
;
set hisfile=19_PGV/m_1.txt
hist write 201 vs 2
set hisfile=19_PGV/m_2.txt
hist write 202 vs 2
;
set hisfile=19_PGV/m_3.txt
hist write 211 vs 2
set hisfile=19_PGV/m_4.txt
hist write 212 vs 2
;
;
set hisfile=19_PGV/x_1.txt
hist write 101 vs 2
set hisfile=19_PGV/y_1.txt
hist write 102 vs 2
set hisfile=19_PGV/x_2.txt
hist write 103 vs 2
set hisfile=19_PGV/y_2.txt
hist write 104 vs 2
;
;
set hisfile=19_PGV/x_3.txt
hist write 111 vs 2
set hisfile=19_PGV/y_3.txt
hist write 112 vs 2
set hisfile=19_PGV/x_4.txt
hist write 113 vs 2
set hisfile=19_PGV/y_4.txt
hist write 114 vs 2
set hisfile=blank
;
;
