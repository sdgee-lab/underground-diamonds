struct prop 5001 density 2500
;
set mech on
set dyn=on
;set flow on
;set mu on
;set fast off
set dytime=0.0
set step 200000000
set large
set ncwrite 100                    ; set saving step
set overwrite on
;
;set dy_damping local 0.02
set dy_damp rayl 0.01 4.5       ; define 5% damping for ground elements
ini dy_damp hyst sig3 1.0 -0.45 -1.1  ; define hysteris of ground elements G D
;
;
;Read Velocity Time History
his read 100 ../Time-Histories/Vel_c/49_PGV.his
hist write 100 table 100
;
; apply dynamic boundaries at side boundaries and bottom boundary
ini xvel=0.0 yvel=0.0 xdisp=0.0 ydisp=0.0
;
; Velocity Time History
apply ff
attach aside from 1,1 to 1,9 bside from 83,1 to 83,9
attach aside from 84,11 to 84,1 bside from 83,19 to 83,9
attach aside from 268,1 to 268,5 bside from 251,18 to 251,22
attach aside from 125,1 to 125,18 bside from 251,1 to 251,18
attach aside from 303,1 to 303,9 bside from 370,1 to 370,9
apply xvel=0.01 hist table 100 from 1,1 to 19,1
apply xvel=0.01 hist table 100 from 20,1 to 36,1
apply xvel=0.01 hist table 100 from 37,1 to 83,1
;
apply yvel=0.0 from 1,1 to 19,1
apply yvel=0.0 from 20,1 to 36,1
apply yvel=0.0 from 37,1 to 83,1
;
;
;
hist reset
history 2 dytime
; bl tr moment
history 201 element 26 moment1
history 202 element 58 moment1
; br tl
history 211 element 42 moment1
history 212 element 10 moment1
;
;
history 101 xdisp i=163, j=1
history 102 ydisp i=163, j=1
history 103 xdisp i=186, j=17
history 104 ydisp i=186, j=17
;
history 111 xdisp i=186, j=1
history 112 ydisp i=155, j=8
history 113 xdisp i=139, j=42
history 114 ydisp i=163, j=17
;
;
history 10 xvel i=72, j=1
;
history 50 xvel i=375 j=15
history 51 xvel i=501, j=5
history 55 xvel i=354, j=2
;
history 60 xaccel i=375, j=15
;
;
;
set dydt = 0.00001
solve dytime = 56.0; set time of input motion
;
;
set hisfile=49_PGV/100.txt
hist write 100 vs 2
;
set hisfile=49_PGV/0010_Xvel_base.txt
hist write 10 vs 2
set hisfile=49_PGV/0050_Xvel_375_15.txt
hist write 50 vs 2
set hisfile=49_PGV/0051_Xvel_501_5.txt
hist write 51 vs 2
set hisfile=49_PGV/0055_Xvel_354_2.txt
hist write 55 vs 2
set hisfile=49_PGV/0060_Xaccel_375_15.txt
hist write 60 vs 2
;
set hisfile=49_PGV/m_1.txt
hist write 201 vs 2
set hisfile=49_PGV/m_2.txt
hist write 202 vs 2
;
set hisfile=49_PGV/m_3.txt
hist write 211 vs 2
set hisfile=49_PGV/m_4.txt
hist write 212 vs 2
;
;
set hisfile=49_PGV/x_1.txt
hist write 101 vs 2
set hisfile=49_PGV/y_1.txt
hist write 102 vs 2
set hisfile=49_PGV/x_2.txt
hist write 103 vs 2
set hisfile=49_PGV/y_2.txt
hist write 104 vs 2
;
;
set hisfile=49_PGV/x_3.txt
hist write 111 vs 2
set hisfile=49_PGV/y_3.txt
hist write 112 vs 2
set hisfile=49_PGV/x_4.txt
hist write 113 vs 2
set hisfile=49_PGV/y_4.txt
hist write 114 vs 2
;
;
